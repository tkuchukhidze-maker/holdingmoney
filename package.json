{
  "name": "episodeholding",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/unit.test.ts",
    "test:integration": "node --experimental-strip-types --test --test-concurrency=1 tests/integration.test.ts",
    "db:migrate": "node --env-file=.env --experimental-strip-types scripts/migrate.ts",
    "db:seed": "node --env-file=.env --experimental-strip-types scripts/seed.ts",
    "admin:grant": "node --env-file=.env --experimental-strip-types scripts/grant-admin.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "mail:send": "node --env-file=.env --experimental-strip-types scripts/mail-worker.ts",
    "mail:preview": "node --env-file=.env --experimental-strip-types scripts/mail-worker.ts --preview",
    "db:migrate:cloud": "node --experimental-strip-types scripts/migrate.ts"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "5.9.3"
  }
}
