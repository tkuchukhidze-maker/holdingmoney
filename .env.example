DATABASE_URL=postgresql://episode:CHANGE_ME@127.0.0.1:5432/episode
POSTGRES_USER=episode
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=episode
APP_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
# Development: verification/reset links go only to the local mail outbox.
# Production requires HTTPS, email verification and a configured sender.
REQUIRE_EMAIL_VERIFICATION=true
RESEND_API_KEY=
EMAIL_FROM=
# Set this only behind a proxy that overwrites x-forwarded-for.
TRUST_PROXY=false
